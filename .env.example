# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Pocket Option session id (SSID). This is NOT an API key you sign up for —
# there's no official Pocket Option API. See README.md, section "Как
# получить SSID (Windows, пошагово)" for the full walkthrough. Short version —
# there is no single fixed cookie name this always comes from (it has
# genuinely varied by account/region — this file has been wrong about it
# twice already; don't trust a cookie name claim, including this one, over
# what your own installed package's source says — see
# scripts/explain_ssid_requirements.py):
#   Easiest: run `python scripts\capture_ssid_playwright.py` (needs
#   `pip install playwright && playwright install chromium` first). It opens
#   a real, visible browser window; you log in yourself as usual, and it
#   captures the auth frame from real network traffic automatically — no
#   need to know any cookie name at all.
#   Manual alternative: DevTools -> Network tab -> filter "WS" -> reload the
#   page (F5) -> that connection's Messages/Frames view -> the outgoing frame
#   starting with 42["auth", -> copy it whole.
#   To test a candidate value (e.g. from any cookie you do have) against the
#   real server without editing this file first: `python
#   scripts\probe_ssid_candidate.py "<value>"`.
#   Paste the final result here as-is, on one line, with no surrounding
#   quotes/spaces.
# The bot checks the *format* of this value at startup — the same fields
# (session, uid) and JSON shape the real PocketOptionAsync itself requires
# (verified by reading its sanitize_and_validate_ssid()) — and will refuse to
# start with a clear error if it's obviously wrong (empty, this placeholder,
# mangled by copy-paste, missing required fields) — see market_data/ssid.py.
# It cannot detect an EXPIRED-but-well-formed SSID until it actually tries to
# connect; that check also runs once at startup (see main.py) with its own
# clear error.
# The whole bot reads quotes from THIS ONE account for every Telegram user.
# Keep it private — it grants full access to that Pocket Option account.
POCKET_OPTION_SSID=your_pocket_option_ssid_here

# Optional fallback provider (not used by default — see README). Only needed
# if you switch main.py back to TwelveDataProvider.
TWELVE_DATA_API_KEY=

# Optional proxy used ONLY for the bot's own connection to Telegram
# (api.telegram.org) — not for Pocket Option or TwelveData. Fixes the "have
# to open the VPN app every time" problem: set this up once and the bot
# connects through it automatically on every start, with nothing to click.
# See README, "Работа без ручного впн" for the recommended one-time setup
# (Cloudflare WARP in Proxy Mode, running as a background Windows service —
# socks5://127.0.0.1:40000). Leave empty if Telegram is reachable directly.
TELEGRAM_PROXY_URL=

# Anthropic API key — used by ai/review.py as a second opinion on top of the
# rule-based verdict (analysis/confirmation.py). If left unset, the bot still
# runs: every signal is shown/stored without the Claude review step, and this
# is stated explicitly in the message — it does not silently pretend to have
# reviewed it.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# Where the SQLite signal log lives (storage/) — every generated signal and,
# once its expiration passes, its real WIN/LOSS/UNKNOWN outcome.
DATABASE_PATH=signals.db
# How often (seconds) the background task checks for expired signals to resolve.
RESOLVER_INTERVAL_SECONDS=15

# Your own numeric Telegram chat_id (a person, not the bot) — where
# market_data/session_monitor.py sends an alert if Pocket Option looks
# genuinely disconnected (not a one-off blip), and another when it recovers.
# See README, "24/7 без присмотра: что делать, когда SSID протухнет", for
# why this can't be avoided entirely (no official API = no refresh token)
# and for how to find your chat_id (message the bot once, then check its
# logs — no third-party bot needed). Leave empty to only log this, not alert.
TELEGRAM_ADMIN_CHAT_ID=
# How often (seconds) the monitor re-checks the connection, and how many
# consecutive failed checks in a row count as a real outage worth alerting on
# (as opposed to one transient blip that recovers on its own).
POCKET_OPTION_HEALTH_CHECK_INTERVAL_SECONDS=300
POCKET_OPTION_HEALTH_CHECK_FAILURE_THRESHOLD=3

LOG_LEVEL=INFO
